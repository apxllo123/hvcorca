{
  "name": "hvcorca",
  "version": "1.1.1",
  "description": "hvcorca - Roblox TS bundle with darklua",
  "main": "main.client.lua",
  "scripts": {
    "build": "rbxtsc",
    "watch": "rbxtsc -w",
    "rojo": "mkdirp dist && rojo build -o dist/main.rbxm",
    "bundle:dev": "pnpm run rojo && cross-env ENV=development remodel run ci/bundle.lua dist/main-dev.lua dev debug",
    "bundle:prod": "pnpm run rojo && cross-env ENV=production remodel run ci/bundle.lua dist/main.lua",
    "bundle": "pnpm run bundle:dev && pnpm run bundle:prod",
    "verify:bundle": "node ci/verify-bundle.mjs dist/main.lua dist/main-dev.lua",
    "lint": "eslint src/ --ext .ts,.tsx --fix",
    "lint:ci": "eslint src/ --ext .ts,.tsx --max-warnings 0"
  },
  "keywords": [
    "roblox",
    "rbxts",
    "darklua"
  ],
  "author": "hvcorca (Richie0866 fork)",
  "license": "MIT",
  "devDependencies": {
    "@rbxts/compiler-types": "1.3.2-types.0",
    "@rbxts/types": "1.0.571",
    "@typescript-eslint/eslint-plugin": "^5.48.2",
    "@typescript-eslint/parser": "^5.48.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.32.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-roblox-ts": "^0.0.35",
    "mkdirp": "^2.1.3",
    "prettier": "^2.8.3",
    "roblox-ts": "1.2.7",
    "typescript": "4.5.5"
  },
  "dependencies": {
    "@rbxts/roact": "1.4.0-ts.2",
    "@rbxts/roact-hooked": "1.2.4",
    "@rbxts/roact-rodux-hooked": "1.0.4",
    "@rbxts/object-utils": "1.0.4",
    "@rbxts/rodux": "3.0.0-ts.3",
    "@rbxts/services": "1.2.0",
    "rbxts-transform-debug": "^2.0.3",
    "@rbxts/flipper": "2.0.1",
    "@rbxts/make": "1.0.6"
  }
}
